RABBITMQ_USER=workshop
RABBITMQ_PASSWORD=workshop
MYSQL_USER=workshop
MYSQL_PASSWORD=workshop
MYSQL_ROOT_PASSWORD=root-workshop

# Credenciais administrativas somente para o laboratório local
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-workshop

# Publique config-repo na branch indicada de um repositório GitHub acessível.
CONFIG_GIT_URI=https://github.com/F290-LDMP/workshop-microservices.git
CONFIG_GIT_LABEL=central-configuration
CONFIG_SERVER_USER=config
CONFIG_SERVER_PASSWORD=config-workshop
# Somente para GitHub privado: usuário e token com leitura do repositório.
CONFIG_GIT_USERNAME=
CONFIG_GIT_PASSWORD=
